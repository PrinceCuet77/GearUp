DATABASE_URL=
PORT=

# Frontend origin. Fallback for CORS and the post-Google-login redirect.
# No trailing slash (it is stripped anyway, but keep it clean).
APP_URL=

# Backend API URL. Used for SSLCommerz callback URLs, and compared against
# APP_URL to decide the auth cookie flags: different hostnames mean the cookies
# are cross-site and must be issued SameSite=None; Secure.
API_URL=

# Extra frontend origins allowed to call this API with credentials,
# comma-separated (staging, retired domains, ...). APP_URL is always allowed.
CORS_ORIGINS=

BCRYPT_SALT_ROUNDS=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Signs the OAuth `state` param (carries the selected role through the Google
# redirect). Falls back to JWT_ACCESS_SECRET when unset.
OAUTH_STATE_SECRET=